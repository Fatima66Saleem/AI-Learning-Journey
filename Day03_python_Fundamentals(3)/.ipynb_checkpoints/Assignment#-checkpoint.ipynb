   "source": [
    "# Ask the user for a string and check whether it is a palindrome or not.\n",
    "# A palindrome is a string which is same when we read it forward & backward. Eg -\n",
    "# “madam”, “racecar” etc.\n",
    "\n",
    "value = input(\"Enter the string: \")\n",
    "\n",
    "for ch in value:\n",
    "    print(ch)"
