   "source": [
    "class Bank_details:\n",
    "    def __init__(self, name , balance):\n",
    "        self.name = name # public\n",
    "        self.__balance = balance  # private\n",
    "\n",
    "    def getter(self):\n",
    "        return self.__balance\n",
    "\n",
    "\n",
    "acc1 = Bank_details(\"Meezan\", 3000)\n",
    "\n",
    "print(acc1.name, acc1.getter())\n",
    "\n"
   ]
